# Local development only. Production values must come from a secret manager.
ENVIRONMENT=local
SERVICE_ROLE=test
RELEASE=dev

# Required only for live OpenAI calls. Never commit a value here.
OPENAI_API_KEY=

# Local substrate defaults. Replace every value outside local development.
DATABASE_URL=postgresql+psycopg://platform_app:platform_dev_only@127.0.0.1:5442/platform
DATABASE_OWNER_URL=postgresql+psycopg://platform_owner:platform_dev_only@127.0.0.1:5442/platform
DATABASE_RELAY_URL=postgresql+psycopg://platform_relay:platform_dev_only@127.0.0.1:5442/platform
REDIS_URL=redis://127.0.0.1:6389/0
CELERY_BROKER_URL=redis://127.0.0.1:6389/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6389/2
S3_ENDPOINT_URL=http://127.0.0.1:9100
S3_ACCESS_KEY=platform
S3_SECRET_KEY=platform_dev_only
OTLP_ENDPOINT=http://127.0.0.1:4317
JWT_SECRET=dev-only-not-a-secret-padded-to-32+
TELEMETRY_HMAC_KEY=

# GraphRAG is off unless both of these are set. The engine tree lives outside
# this repository, so there is no default root — graph chat, onboarding drafts
# and schema validation all refuse while this is unset.
GRAPHRAG_ENABLED=false
GRAPHRAG_ENGINE_ROOT=
